{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline Foundry pilot evidence intake, not provider attestation or launch approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reviewed_source_sha", "plan_base_sha", "plan_sha256", "run_id", "evaluated_at", "requested", "claims"],
  "properties": {
    "schema_version": {"const": "foundry-pilot-evidence-intake-v1"},
    "reviewed_source_sha": {"$ref": "#/$defs/commit"},
    "plan_base_sha": {"$ref": "#/$defs/commit"},
    "plan_sha256": {"$ref": "#/$defs/digest"},
    "run_id": {"const": "gpt56_sol_foundry_codex_pilot5_v1"},
    "evaluated_at": {"$ref": "#/$defs/time"},
    "requested": {
      "const": {"provider": "azure", "model": "gpt-5.6-sol", "harness": "codex", "reasoning_effort": "max", "model_context_window": 1000000, "credential_policy": "repository_approved_entra_only"}
    },
    "claims": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["role", "artifact"],
        "properties": {
          "role": {"enum": ["identity", "reasoning", "context", "native_caps", "usage", "tariff"]},
          "artifact": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/file"}]}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}(?![\\s\\S])"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"},
    "nullable_time": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/time"}]},
    "positive": {"type": ["integer", "null"], "minimum": 1},
    "count": {"type": ["integer", "null"], "minimum": 0},
    "meter": {"type": ["string", "null"], "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"},
    "currency": {"enum": [null, "USD", "EUR", "GBP", "JPY", "KRW", "CAD", "AUD", "CHF", "INR", "BRL", "CNY"]},
    "region": {"enum": [null, "eastus", "eastus2", "westus", "westus2", "westus3", "centralus", "northcentralus", "southcentralus", "westcentralus", "swedencentral", "switzerlandnorth", "westeurope", "northeurope", "francecentral", "germanywestcentral", "uksouth", "ukwest", "japaneast", "japanwest", "koreacentral", "australiaeast", "canadacentral", "eastasia", "southeastasia", "brazilsouth", "southafricanorth", "centralindia", "southindia", "uaenorth"]},
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"enum": ["artifacts/identity.json", "artifacts/reasoning.json", "artifacts/context.json", "artifacts/native_caps.json", "artifacts/usage.json", "artifacts/tariff.json"]},
        "size": {"type": "integer", "minimum": 1, "maximum": 65536},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "account", "project", "deployment", "served_model", "served_model_version"],
      "properties": {
        "provider": {"const": "azure"},
        "account": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/resource_identity"}]},
        "project": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/resource_identity"}]},
        "deployment": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/resource_identity"}]},
        "served_model": {"enum": [null, "gpt-5.6-sol"]},
        "served_model_version": {"type": ["string", "null"], "maxLength": 32, "pattern": "^[0-9]+([.-][0-9]+)*(?![\\s\\S])"}
      }
    },
    "resource_identity": {
      "description": "SHA256 of exact UTF-8 externally recorded resource ID bytes, without normalization. Not a file digest or identity approval.",
      "type": "object", "additionalProperties": false, "required": ["resource_id_sha256"],
      "properties": {"resource_id_sha256": {"$ref": "#/$defs/digest"}}
    },
    "reasoning": {
      "type": "object", "additionalProperties": false, "required": ["reasoning_effort", "response_status", "response_id_sha256"],
      "properties": {
        "reasoning_effort": {"enum": [null, "max"]}, "response_status": {"enum": [null, "completed"]},
        "response_id_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}
      }
    },
    "context": {
      "type": "object", "additionalProperties": false, "required": ["scope", "accepted_input_tokens", "accepted_output_tokens", "unit", "response_status", "response_id_sha256"],
      "properties": {
        "scope": {"enum": [null, "single_response"]},
        "response_id_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "accepted_input_tokens": {"$ref": "#/$defs/count"}, "accepted_output_tokens": {"$ref": "#/$defs/count"},
        "unit": {"enum": [null, "tokens"]}, "response_status": {"enum": [null, "completed"]}
      }
    },
    "native_caps": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "enforcement", "model_calls", "input_tokens", "output_tokens", "call_unit", "token_unit"],
      "properties": {
        "scope": {"enum": [null, "per_attempt"]}, "enforcement": {"enum": [null, "native"]},
        "model_calls": {"$ref": "#/$defs/positive"}, "input_tokens": {"$ref": "#/$defs/positive"}, "output_tokens": {"$ref": "#/$defs/positive"},
        "call_unit": {"enum": [null, "calls"]}, "token_unit": {"enum": [null, "tokens"]}
      }
    },
    "usage_meter": {
      "type": "object", "additionalProperties": false, "required": ["meter_id", "quantity", "unit"],
      "properties": {"meter_id": {"$ref": "#/$defs/meter"}, "quantity": {"$ref": "#/$defs/count"}, "unit": {"enum": [null, "tokens"]}}
    },
    "rate": {
      "type": "object", "additionalProperties": false, "required": ["meter_id", "amount", "per_tokens"],
      "properties": {
        "meter_id": {"$ref": "#/$defs/meter"},
        "amount": {"type": ["string", "null"], "maxLength": 32, "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?(?![\\s\\S])"},
        "per_tokens": {"$ref": "#/$defs/positive"}
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["currency", "region", "meters", "partial_reasons"],
      "properties": {
        "currency": {"$ref": "#/$defs/currency"}, "region": {"$ref": "#/$defs/region"},
        "partial_reasons": {"type": "array", "uniqueItems": true, "items": {"enum": ["usage_absent", "usage_partial", "price_missing", "call_reachability_unknown"]}},
        "meters": {
          "type": "object", "additionalProperties": false, "required": ["input_tokens", "cached_input_tokens", "output_tokens"],
          "properties": {"input_tokens": {"$ref": "#/$defs/usage_meter"}, "cached_input_tokens": {"$ref": "#/$defs/usage_meter"}, "output_tokens": {"$ref": "#/$defs/usage_meter"}}
        }
      }
    },
    "tariff": {
      "type": "object", "additionalProperties": false,
      "required": ["currency", "region", "effective_at", "expires_at", "tariff_source", "rates"],
      "properties": {
        "currency": {"$ref": "#/$defs/currency"}, "region": {"$ref": "#/$defs/region"},
        "effective_at": {"$ref": "#/$defs/nullable_time"}, "expires_at": {"$ref": "#/$defs/nullable_time"},
        "tariff_source": {"enum": [null, "azure_price_sheet", "azure_retail_prices", "foundry_contract_schedule"]},
        "rates": {
          "type": "object", "additionalProperties": false, "required": ["input_tokens", "cached_input_tokens", "output_tokens"],
          "properties": {"input_tokens": {"$ref": "#/$defs/rate"}, "cached_input_tokens": {"$ref": "#/$defs/rate"}, "output_tokens": {"$ref": "#/$defs/rate"}}
        }
      }
    },
    "external_live_runtime_time": {
      "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z(?![\\s\\S])"
    },
    "external_live_bytes": {
      "type": "object", "additionalProperties": false, "required": ["size", "sha256"],
      "properties": {
        "size": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "external_live_task_id": {
      "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "external_live_result": {
      "type": "object", "additionalProperties": false, "required": ["size", "sha256", "result_fingerprint"],
      "properties": {
        "size": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "sha256": {"$ref": "#/$defs/digest"}, "result_fingerprint": {"$ref": "#/$defs/digest"}
      }
    },
    "external_live_request": {
      "description": "Exact local app-server serialization and RPC correlation, never provider HTTP identity.",
      "type": "object", "additionalProperties": false, "required": ["request_id_sha256", "serialized_utf8"],
      "properties": {
        "request_id_sha256": {"$ref": "#/$defs/digest"}, "serialized_utf8": {"$ref": "#/$defs/external_live_bytes"}
      }
    },
    "external_live_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "reviewed_source_sha", "task_ids", "run_started_at", "run_completed_at", "capture", "capture_linkage_sha256", "prepared", "upstream_bundles_sha256", "caps_ready", "caps_reservation", "wire_ready", "wire_reservation", "host_ready", "host_reservation", "evidence_ready", "evidence_roles", "accepted_results"],
      "properties": {
        "run_id": {"const": "gpt56_sol_foundry_codex_pilot5_v1"}, "reviewed_source_sha": {"$ref": "#/$defs/commit"},
        "task_ids": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/external_live_task_id"}},
        "run_started_at": {"$ref": "#/$defs/external_live_runtime_time"}, "run_completed_at": {"$ref": "#/$defs/external_live_runtime_time"},
        "capture": {"$ref": "#/$defs/external_live_bytes"}, "capture_linkage_sha256": {"$ref": "#/$defs/digest"},
        "prepared": {"$ref": "#/$defs/external_live_bytes"}, "upstream_bundles_sha256": {"$ref": "#/$defs/digest"},
        "caps_ready": {"$ref": "#/$defs/external_live_bytes"}, "caps_reservation": {"$ref": "#/$defs/external_live_bytes"},
        "wire_ready": {"$ref": "#/$defs/external_live_bytes"}, "wire_reservation": {"$ref": "#/$defs/external_live_bytes"},
        "host_ready": {"$ref": "#/$defs/external_live_bytes"}, "host_reservation": {"$ref": "#/$defs/external_live_bytes"},
        "evidence_ready": {"$ref": "#/$defs/external_live_bytes"},
        "evidence_roles": {
          "type": "object", "additionalProperties": false, "required": ["identity", "reasoning", "context", "native_caps", "usage", "tariff"],
          "properties": {
            "identity": {"$ref": "#/$defs/external_live_bytes"}, "reasoning": {"$ref": "#/$defs/external_live_bytes"},
            "context": {"$ref": "#/$defs/external_live_bytes"}, "native_caps": {"$ref": "#/$defs/external_live_bytes"},
            "usage": {"$ref": "#/$defs/external_live_bytes"}, "tariff": {"$ref": "#/$defs/external_live_bytes"}
          }
        },
        "accepted_results": {
          "type": "object", "additionalProperties": false,
          "required": ["step2_inference_results_condition_a.json", "step2_inference_results.json"],
          "properties": {
            "step2_inference_results_condition_a.json": {"$ref": "#/$defs/external_live_result"},
            "step2_inference_results.json": {"$ref": "#/$defs/external_live_result"}
          }
        }
      }
    },
    "external_live_attempt_binding": {
      "description": "Run and accepted-row bounds do not measure individual provider transport timing.",
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "attempt_index", "retry_kind", "logical_turn", "not_before", "accepted_at", "caps_receipt", "wire_receipt", "host_receipt", "accepted_row_sha256", "thread_start", "turn_start", "thread_id_sha256", "turn_id_sha256"],
      "properties": {
        "task_id": {"$ref": "#/$defs/external_live_task_id"}, "attempt_index": {"type": "integer", "minimum": 0, "maximum": 3},
        "retry_kind": {"enum": ["initial", "infrastructure"]}, "logical_turn": {"const": 1},
        "not_before": {"$ref": "#/$defs/external_live_runtime_time"}, "accepted_at": {"$ref": "#/$defs/external_live_runtime_time"},
        "caps_receipt": {"$ref": "#/$defs/external_live_bytes"}, "wire_receipt": {"$ref": "#/$defs/external_live_bytes"},
        "host_receipt": {"$ref": "#/$defs/external_live_bytes"}, "accepted_row_sha256": {"$ref": "#/$defs/digest"},
        "thread_start": {"$ref": "#/$defs/external_live_request"}, "turn_start": {"$ref": "#/$defs/external_live_request"},
        "thread_id_sha256": {"$ref": "#/$defs/digest"}, "turn_id_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "external_live_count": {
      "allOf": [{"$ref": "#/$defs/count"}, {"maximum": 9223372036854775807}]
    },
    "external_live_usage": {
      "description": "The existing Foundry usage vocabulary, with bounded quantities; billing is an independent external assertion.",
      "allOf": [
        {"$ref": "#/$defs/usage"},
        {"properties": {"meters": {"properties": {
          "input_tokens": {"properties": {"quantity": {"$ref": "#/$defs/external_live_count"}}},
          "cached_input_tokens": {"properties": {"quantity": {"$ref": "#/$defs/external_live_count"}}},
          "output_tokens": {"properties": {"quantity": {"$ref": "#/$defs/external_live_count"}}}
        }}}}
      ]
    },
    "external_live_attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["binding", "source_kind", "issuer", "window_started_at", "window_ended_at", "observed_at", "issued_at", "valid_until", "provider_request_id_sha256", "provider_response_id_sha256", "served", "usage", "billing", "tariff"],
      "properties": {
        "binding": {"$ref": "#/$defs/external_live_attempt_binding"},
        "source_kind": {"const": "foundry_response_export"}, "issuer": {"const": "microsoft_foundry"},
        "window_started_at": {"$ref": "#/$defs/time"}, "window_ended_at": {"$ref": "#/$defs/time"},
        "observed_at": {"$ref": "#/$defs/time"}, "issued_at": {"$ref": "#/$defs/time"}, "valid_until": {"$ref": "#/$defs/time"},
        "provider_request_id_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "provider_response_id_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "served": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/subject"}]},
        "usage": {
          "description": "External corroboration of available raw app-server cumulative counters, not provider billing; missing native counters cannot be guessed.",
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/external_live_usage"}]
        },
        "billing": {
          "description": "Independent unverified provider billing meter quantities; never derived from or equated with app-server token counters.",
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/external_live_usage"}]
        },
        "tariff": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/tariff"}]}
      }
    },
    "external_live_receipt": {
      "description": "Caller-pinned sanitized external claims checked against an exact finalized in-process owner. Neither hashes nor the owner authenticate the provider or distinguish disguised synthetic evidence; no fact is eligible to clear launch blockers.",
      "type": "object", "additionalProperties": false, "required": ["schema_version", "binding", "attempts"],
      "properties": {
        "schema_version": {"const": "pilot-external-live-receipt-v1"}, "binding": {"$ref": "#/$defs/external_live_binding"},
        "attempts": {"type": "array", "minItems": 5, "maxItems": 20, "items": {"$ref": "#/$defs/external_live_attempt"}}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "source_kind", "issued_at", "observed_at", "valid_until", "subject", "documented", "observed"],
      "properties": {
        "role": {"enum": ["identity", "reasoning", "context", "native_caps", "usage", "tariff"]},
        "source_kind": {"enum": [null, "foundry_identity_export", "foundry_response_export", "codex_native_enforcement_export", "foundry_usage_export", "foundry_tariff_export", "documentation"]},
        "issued_at": {"$ref": "#/$defs/nullable_time"}, "observed_at": {"$ref": "#/$defs/nullable_time"}, "valid_until": {"$ref": "#/$defs/nullable_time"},
        "subject": {"$ref": "#/$defs/subject"}, "documented": {}, "observed": {}
      }
    }
  }
}
