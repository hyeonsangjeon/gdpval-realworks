{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GDPVal Grade Result",
  "$defs": {
    "visualScope": {
      "type": "object",
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "workbook_page": {"type": "integer", "minimum": 1},
        "slide": {"type": "integer", "minimum": 1}
      },
      "maxProperties": 1,
      "additionalProperties": false
    },
    "visualRenderer": {
      "type": "object",
      "required": ["rasterizer"],
      "properties": {
        "converter": {"type": "string", "enum": ["libreoffice"]},
        "rasterizer": {"type": "string", "enum": ["pymupdf", "pillow"]},
        "dpi": {"type": "integer", "minimum": 1},
        "libreoffice_binary": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
        "libreoffice_version": {"type": "string", "minLength": 1},
        "pymupdf_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "visualRendererMetadata": {
      "type": "object",
      "required": ["kind", "source_kind", "renderer", "byte_size"],
      "properties": {
        "kind": {"const": "image_png_base64"},
        "source_kind": {"type": "string", "enum": ["pdf", "xlsx", "pptx", "image"]},
        "source_page_count": {"type": "integer", "minimum": 1},
        "source_sheet_count": {"type": "integer", "minimum": 1},
        "source_slide_count": {"type": "integer", "minimum": 1},
        "converted_page_count": {"type": "integer", "minimum": 1},
        "renderer": {"$ref": "#/$defs/visualRenderer"},
        "byte_size": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "visualCoverageMetadata": {
      "type": "object",
      "required": ["coverage_mode", "criterion_scope", "sampled_surface_count", "total_surface_count"],
      "properties": {
        "coverage_mode": {"const": "sampled_first_surface"},
        "criterion_scope": {"type": "string", "enum": ["overall_style", "generic_visual_fallback"]},
        "sampled_surface_count": {"type": "integer", "minimum": 1},
        "total_surface_count": {"type": ["integer", "null"], "minimum": 1}
      },
      "additionalProperties": false
    },
    "visualVision": {
      "type": "object",
      "required": ["verdict", "evidence", "confidence", "reasoning", "judge_error"],
      "properties": {
        "verdict": {"type": ["string", "null"], "enum": ["pass", "partial", "fail", "judge_error", null]},
        "evidence": {"type": ["string", "null"], "maxLength": 200},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "reasoning": {"type": ["string", "null"], "maxLength": 300},
        "judge_error": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "visualProvenanceEntry": {
      "type": "object",
      "required": ["path", "source_sha256", "scope", "renderer_metadata", "coverage_metadata", "vision"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\r\\n]+$"
        },
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scope": {"$ref": "#/$defs/visualScope"},
        "renderer_metadata": {"$ref": "#/$defs/visualRendererMetadata"},
        "coverage_metadata": {"$ref": "#/$defs/visualCoverageMetadata"},
        "vision": {"$ref": "#/$defs/visualVision"}
      },
      "additionalProperties": false
    },
    "childGrade": {
      "type": "object",
      "properties": {
        "visual_provenance": {
          "type": "array",
          "items": {"$ref": "#/$defs/visualProvenanceEntry"}
        }
      },
      "additionalProperties": true
    }
  },
  "type": "object",
  "allOf": [
    {
      "if": {"required": ["run_status"]},
      "then": {
        "required": ["azure_ai_routes", "azure_ai_runtime_fingerprint"]
      }
    }
  ],
  "required": [
    "schema_version",
    "experiment_id",
    "experiment_yaml_name",
    "judge",
    "rubric",
    "prompt",
    "graded_at",
    "graded_by",
    "tasks",
    "summary"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"], "description": "1.0 = v1 grade JSON (legacy, pre-sign-aware). 1.1 = v2sm-backfilled or freshly-graded with PR1 sign-aware math (model_did_right, |max_score|>=4 critical, positive-only denominator, pct_raw diagnostic)."},
    "run_status": {"enum": ["partial", "final", "diagnostic"]},
    "expected_task_count": {"type": "integer", "minimum": 1},
    "expected_ordered_task_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "experiment_id": {"type": "string"},
    "experiment_yaml_name": {"type": "string"},
    "source_inference_experiment_id": {"type": ["string", "null"]},
    "source_inference_run_dir": {"type": ["string", "null"]},
    "source_inference_repo_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "source_inference_revision": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_azure_ai_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["endpoint_kind", "profile", "runtime_fingerprint", "workload"],
        "properties": {
          "endpoint_kind": {"enum": ["direct-v1", "project", "legacy-dated"]},
          "profile": {"enum": ["direct-v1", "project-ci", "legacy-rollback"]},
          "runtime_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "workload": {"enum": ["inference", "code-interpreter", "narrative", "grader"]}
        },
        "additionalProperties": false
      }
    },
    "source_azure_ai_provenance_status": {
      "enum": ["runtime-verified", "verified-sidecar", "legacy-missing", "local-runtime"]
    },
    "azure_ai_routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["endpoint_kind", "profile", "runtime_fingerprint", "workload"],
        "properties": {
          "endpoint_kind": {"enum": ["direct-v1", "project", "legacy-dated"]},
          "profile": {"enum": ["direct-v1", "project-ci", "legacy-rollback"]},
          "runtime_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "workload": {"const": "grader"}
        },
        "additionalProperties": false
      }
    },
    "azure_ai_runtime_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "grader_source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "renderer_fingerprint": {
      "type": ["object", "null"],
      "required": ["libreoffice_binary", "libreoffice_version", "pymupdf_version"],
      "properties": {
        "libreoffice_binary": {"type": "string", "minLength": 1},
        "libreoffice_version": {"type": "string", "minLength": 1},
        "pymupdf_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "inference_model": {"type": "string"},
    "inference_completed_at": {"type": ["string", "null"]},
    "judge": {
      "type": "object",
      "required": [
        "provider",
        "api",
        "model",
        "deployment",
        "api_version",
        "reasoning_effort",
        "temperature",
        "seed",
        "config_name",
        "config_hash"
      ],
      "properties": {
        "provider": {"type": "string"},
        "api": {"type": "string"},
        "model": {"type": "string"},
        "deployment": {"type": "string"},
        "api_version": {"type": "string"},
        "reasoning_effort": {"type": "string"},
        "temperature": {"type": "number"},
        "seed": {"type": "integer"},
        "config_name": {"type": "string"},
        "config_hash": {"type": "string"}
      },
      "additionalProperties": true
    },
    "rubric": {
      "type": "object",
      "required": ["source", "repo_id", "revision", "commit_sha", "short_sha"],
      "properties": {
        "source": {"type": "string"},
        "repo_id": {"type": "string"},
        "revision": {"type": "string"},
        "commit_sha": {"type": "string"},
        "short_sha": {"type": "string"}
      },
      "additionalProperties": true
    },
    "prompt": {
      "type": "object",
      "required": ["template", "version"],
      "properties": {
        "template": {"type": "string"},
        "version": {"type": "string"}
      },
      "additionalProperties": true
    },
    "graded_at": {"type": "string"},
    "graded_by": {"type": "string"},
    "graded_by_version": {"type": "string"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "sector",
          "occupation",
          "items",
          "total_awarded",
          "total_max",
          "pct",
          "critical_fail",
          "gold_referenced",
          "judge_call_count",
          "precheck_count",
          "judge_total_latency_ms",
          "judge_input_tokens",
          "judge_output_tokens",
          "graded_at"
        ],
        "properties": {
          "task_id": {"type": "string"},
          "sector": {"type": "string"},
          "occupation": {"type": "string"},
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "rubric_item_id",
                "criterion",
                "max_score",
                "awarded_score",
                "verdict",
                "decided_by",
                "required",
                "evidence",
                "precheck_pattern_id"
              ],
              "properties": {
                "rubric_item_id": {"type": "string"},
                "criterion": {"type": "string"},
                "max_score": {"type": "number"},
                "awarded_score": {"type": "number"},
                "verdict": {"enum": ["pass", "partial", "fail", "judge_error"]},
                "decided_by": {"enum": ["precheck", "judge"]},
                "required": {"type": ["boolean", "null"]},
                "evidence": {"type": "string", "maxLength": 200},
                "judge_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
                "judge_latency_ms": {"type": ["number", "null"], "minimum": 0},
                "precheck_pattern_id": {"type": ["string", "null"]},
                "judge_raw_response": {"type": ["string", "null"]},
                "model_did_right": {"type": "boolean", "description": "Sign-aware right-outcome flag (PR1 task 100). For positive max_score items, true iff verdict='pass'. For negative max_score (penalty) items, true iff verdict!='pass' (i.e. violation did NOT occur). judge_error is conservatively false."},
                "routing_modality": {"type": ["string", "null"], "enum": ["visual", "audio", "formatting", "text", "mixed", null]},
                "perception_called": {"type": "boolean"},
                "tools_used": {"type": ["array", "null"], "items": {"type": "string"}},
                "visual_provenance": {
                  "type": "array",
                  "items": {"$ref": "#/$defs/visualProvenanceEntry"}
                },
                "target_scope": {"type": ["string", "null"], "enum": ["manifest", "file_target", "primary_bundle", "split_children", "selection_error", null]},
                "target_ids": {"type": ["array", "null"], "items": {"type": "string"}},
                "child_grades": {"type": ["array", "null"], "items": {"$ref": "#/$defs/childGrade"}},
                "aggregation_rule": {"type": ["string", "null"], "enum": ["blocking_min_else_mean", null]},
                "selected_paths": {"type": ["array", "null"], "items": {"type": "string"}},
                "support_paths_visible": {"type": ["array", "null"], "items": {"type": "string"}},
                "selection_status": {"type": ["string", "null"]},
                "selection_error": {"type": ["string", "null"]},
                "score_excluded": {"type": "boolean"},
                "judge_call_count": {"type": "integer", "minimum": 0},
                "judge_input_tokens": {"type": "integer", "minimum": 0},
                "judge_output_tokens": {"type": "integer", "minimum": 0},
                "judge_cached_tokens": {"type": "integer", "minimum": 0},
                "perception_call_count": {"type": "integer", "minimum": 0},
                "perception_input_tokens": {"type": "integer", "minimum": 0},
                "perception_output_tokens": {"type": "integer", "minimum": 0},
                "perception_cached_tokens": {"type": "integer", "minimum": 0},
                "perception_total_latency_ms": {"type": "number", "minimum": 0},
                "render_call_count": {"type": "integer", "minimum": 0},
                "render_total_latency_ms": {"type": "number", "minimum": 0},
                "usage_complete": {"type": "boolean"}
              },
              "additionalProperties": true
            }
          },
          "total_awarded": {"type": "number"},
          "total_max": {"type": "number"},
          "pct": {"type": "number", "minimum": 0, "maximum": 100},
          "pct_raw": {"type": "number", "description": "Un-clamped pct (PR1 task 102). Can be negative when negative-magnitude penalties dominate; can theoretically exceed 100 if the judge over-awards. The clamped `pct` field above is used for schema validity and dashboard display; pct_raw exposes the underlying ratio for diagnostics."},
          "critical_fail": {"type": "boolean"},
          "gold_referenced": {"type": "boolean"},
          "judge_call_count": {"type": "integer", "minimum": 0},
          "precheck_count": {"type": "integer", "minimum": 0},
          "judge_total_latency_ms": {"type": "number", "minimum": 0},
          "judge_input_tokens": {"type": "integer", "minimum": 0},
          "judge_output_tokens": {"type": "integer", "minimum": 0},
          "judge_cached_tokens": {"type": "integer", "minimum": 0},
          "perception_call_count": {"type": "integer", "minimum": 0},
          "perception_input_tokens": {"type": "integer", "minimum": 0},
          "perception_output_tokens": {"type": "integer", "minimum": 0},
          "perception_cached_tokens": {"type": "integer", "minimum": 0},
          "perception_total_latency_ms": {"type": "number", "minimum": 0},
          "render_call_count": {"type": "integer", "minimum": 0},
          "render_total_latency_ms": {"type": "number", "minimum": 0},
          "usage_complete": {"type": "boolean"},
          "selected_deliverables": {"type": ["object", "null"]},
          "reference_files_excluded": {"type": "array", "items": {"type": "string"}},
          "selection_rule": {"type": ["string", "null"]},
          "selection_status": {"type": ["string", "null"]},
          "selection_error": {"type": ["string", "null"]},
          "error": {"type": ["string", "null"]},
          "graded_at": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_tasks", "graded_tasks", "error_tasks", "openai_compat", "wow", "cost"],
      "properties": {
        "total_tasks": {"type": "integer", "minimum": 0},
        "graded_tasks": {"type": "integer", "minimum": 0},
        "error_tasks": {"type": "integer", "minimum": 0},
        "openai_compat": {
          "type": "object",
          "required": ["avg_score_pct", "ci_pct", "perfect_count", "zero_count", "partial_count", "inconsistent_count"],
          "properties": {
            "avg_score_pct": {"type": "number", "minimum": 0, "maximum": 100},
            "ci_pct": {"type": "number", "minimum": 0},
            "perfect_count": {"type": "integer", "minimum": 0},
            "zero_count": {"type": "integer", "minimum": 0},
            "partial_count": {"type": "integer", "minimum": 0},
            "inconsistent_count": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": true
        },
        "wow": {"type": "object"},
        "cost": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
