{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GDPVal Grade Result",
  "$defs": {
    "costUsage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "costMissingReason": {
      "enum": [
        "usage_absent",
        "usage_partial",
        "price_missing",
        "call_reachability_unknown",
        "runtime_cost_unattributable",
        "runtime_cost_unpriced",
        "ledger_absent",
        "stage_unsupported"
      ]
    },
    "costComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "stage",
        "retry_kind",
        "status",
        "model_calls",
        "known_cost_usd",
        "usage",
        "missing_reasons"
      ],
      "properties": {
        "name": {
          "enum": [
            "preprocessing",
            "generation",
            "self_qa",
            "grading",
            "perception",
            "retry"
          ]
        },
        "stage": {
          "enum": [
            "preprocessing",
            "generation",
            "self_qa",
            "grading",
            "perception"
          ]
        },
        "retry_kind": {
          "enum": [
            "none",
            "semantic",
            "infrastructure",
            "resume",
            "internal_recovery"
          ]
        },
        "status": {"enum": ["complete", "partial", "unavailable", "not_run"]},
        "model_calls": {"type": "integer", "minimum": 0},
        "known_cost_usd": {"type": "number", "minimum": 0},
        "usage": {"$ref": "#/$defs/costUsage"},
        "missing_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/costMissingReason"}
        },
        "provider": {"type": ["string", "null"], "minLength": 1},
        "deployment": {"type": ["string", "null"], "minLength": 1},
        "requested_model": {"type": ["string", "null"], "minLength": 1},
        "resolved_model": {"type": ["string", "null"], "minLength": 1},
        "api_version": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "costReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "currency",
        "estimated_cost_usd",
        "known_cost_usd",
        "model_cost_usd",
        "runtime_cost_usd",
        "model_calls",
        "usage",
        "components",
        "price_table_sha256",
        "missing_reasons"
      ],
      "properties": {
        "schema_version": {"const": "cost-receipt-v1"},
        "status": {"enum": ["complete", "partial", "unavailable", "not_run"]},
        "currency": {"const": "USD"},
        "estimated_cost_usd": {"type": ["number", "null"], "minimum": 0},
        "known_cost_usd": {"type": "number", "minimum": 0},
        "model_cost_usd": {"type": "number", "minimum": 0},
        "runtime_cost_usd": {"type": "number", "minimum": 0},
        "model_calls": {"type": "integer", "minimum": 0},
        "usage": {"$ref": "#/$defs/costUsage"},
        "components": {
          "type": "array",
          "items": {"$ref": "#/$defs/costComponent"}
        },
        "price_table_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "missing_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/costMissingReason"}
        }
      },
      "allOf": [
        {
          "$comment": "estimated_cost_usd is a number only where every cost behind it is confirmed. Anywhere else the confirmed part stays in known_cost_usd and the total stays null, so a floor is never read as a total.",
          "if": {
            "required": ["status"],
            "properties": {"status": {"const": "complete"}}
          },
          "then": {"properties": {"estimated_cost_usd": {"type": "number"}}},
          "else": {"properties": {"estimated_cost_usd": {"type": "null"}}}
        }
      ]
    },
    "costLedgerReference": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "visualScope": {
      "type": "object",
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "workbook_page": {"type": "integer", "minimum": 1},
        "slide": {"type": "integer", "minimum": 1}
      },
      "maxProperties": 1,
      "additionalProperties": false
    },
    "visualRenderer": {
      "type": "object",
      "required": ["rasterizer"],
      "properties": {
        "converter": {"type": "string", "enum": ["libreoffice"]},
        "rasterizer": {"type": "string", "enum": ["pymupdf", "pillow"]},
        "dpi": {"type": "integer", "minimum": 1},
        "libreoffice_binary": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
        "libreoffice_version": {"type": "string", "minLength": 1},
        "pymupdf_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "visualRendererMetadata": {
      "type": "object",
      "required": ["kind", "source_kind", "renderer", "byte_size"],
      "properties": {
        "kind": {"const": "image_png_base64"},
        "source_kind": {"type": "string", "enum": ["pdf", "xlsx", "pptx", "docx", "image"]},
        "source_page_count": {"type": "integer", "minimum": 1},
        "source_sheet_count": {"type": "integer", "minimum": 1},
        "source_slide_count": {"type": "integer", "minimum": 1},
        "converted_page_count": {"type": "integer", "minimum": 1},
        "renderer": {"$ref": "#/$defs/visualRenderer"},
        "byte_size": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "visualCoverageMetadata": {
      "type": "object",
      "required": ["coverage_mode", "criterion_scope", "sampled_surface_count", "total_surface_count"],
      "properties": {
        "coverage_mode": {"const": "sampled_first_surface"},
        "criterion_scope": {"type": "string", "enum": ["overall_style", "generic_visual_fallback"]},
        "sampled_surface_count": {"type": "integer", "minimum": 1},
        "total_surface_count": {"type": ["integer", "null"], "minimum": 1}
      },
      "additionalProperties": false
    },
    "visualVision": {
      "type": "object",
      "required": ["verdict", "evidence", "confidence", "reasoning", "judge_error"],
      "properties": {
        "verdict": {"type": ["string", "null"], "enum": ["pass", "partial", "fail", "judge_error", null]},
        "evidence": {"type": ["string", "null"], "maxLength": 200},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "reasoning": {"type": ["string", "null"], "maxLength": 300},
        "judge_error": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "visualProvenanceEntry": {
      "type": "object",
      "required": ["path", "source_sha256", "scope", "renderer_metadata", "coverage_metadata", "vision"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\r\\n]+$"
        },
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scope": {"$ref": "#/$defs/visualScope"},
        "renderer_metadata": {"$ref": "#/$defs/visualRendererMetadata"},
        "coverage_metadata": {"$ref": "#/$defs/visualCoverageMetadata"},
        "vision": {"$ref": "#/$defs/visualVision"}
      },
      "additionalProperties": false
    },
    "childGrade": {
      "type": "object",
      "properties": {
        "visual_provenance": {
          "type": "array",
          "items": {"$ref": "#/$defs/visualProvenanceEntry"}
        }
      },
      "additionalProperties": true
    }
  },
  "type": "object",
  "allOf": [
    {
      "if": {"required": ["run_status"]},
      "then": {
        "required": ["azure_ai_routes", "azure_ai_runtime_fingerprint"]
      }
    },
    {
      "if": {
        "required": ["schema_version"],
        "properties": {"schema_version": {"enum": ["1.2", "1.3", "1.4"]}}
      },
      "then": {
        "required": [
          "run_status",
          "expected_task_count",
          "expected_ordered_task_ids_sha256",
          "azure_ai_routes",
          "azure_ai_runtime_fingerprint"
        ],
        "properties": {
          "summary": {
            "properties": {
              "cost": {
                "required": ["estimated_cost_usd", "pricing_complete", "unpriced_models"],
                "properties": {
                  "estimated_cost_usd": {"type": "null"},
                  "pricing_complete": {"const": false},
                  "unpriced_models": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["schema_version"],
        "properties": {"schema_version": {"enum": ["1.3", "1.4"]}}
      },
      "then": {
        "properties": {
          "tasks": {
            "items": {
              "properties": {
                "items": {
                  "items": {
                    "allOf": [
                      {
                        "if": {
                          "required": ["verdict"],
                          "properties": {"verdict": {"const": "judge_error"}}
                        },
                        "then": {
                          "required": ["score_excluded"],
                          "properties": {"score_excluded": {"const": true}}
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "summary": {
            "properties": {
              "openai_compat": {
                "properties": {
                  "avg_score_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
                  "ci_pct": {"type": ["number", "null"], "minimum": 0}
                }
              },
              "wow": {
                "required": ["judge_error_rate"],
                "properties": {
                  "judge_error_rate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "1.4 puts money beside the token counters that were already there. A grade that calls itself 1.4 carries a receipt on every task and on the summary, and points at the ledger those receipts were read from. A pointer of null is allowed and means no ledger was kept for this run; a missing key is not allowed, because it would be indistinguishable from a reader that simply did not look.",
      "if": {
        "required": ["schema_version"],
        "properties": {"schema_version": {"const": "1.4"}}
      },
      "then": {
        "required": ["cost_ledger"],
        "properties": {
          "tasks": {
            "items": {
              "required": ["grading_cost"],
              "properties": {"grading_cost": {"$ref": "#/$defs/costReceipt"}}
            }
          },
          "summary": {
            "required": ["grading_cost"],
            "properties": {"grading_cost": {"$ref": "#/$defs/costReceipt"}}
          }
        }
      }
    },
    {
      "if": {
        "required": ["schema_version"],
        "properties": {"schema_version": {"enum": ["1.0", "1.1", "1.2"]}}
      },
      "then": {
        "properties": {
          "summary": {
            "properties": {
              "openai_compat": {
                "properties": {
                  "avg_score_pct": {"type": "number"},
                  "ci_pct": {"type": "number"}
                }
              }
            }
          }
        }
      }
    }
  ],
  "required": [
    "schema_version",
    "experiment_id",
    "experiment_yaml_name",
    "judge",
    "rubric",
    "prompt",
    "graded_at",
    "graded_by",
    "tasks",
    "summary"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1", "1.2", "1.3", "1.4"], "description": "1.0 = legacy item-level grade JSON. 1.1 = sign-aware backfill. 1.2 = lifecycle and explicit unpriced-cost provenance. 1.3 = judge_error is score-excluded and judge_error_rate remains required; headline scores are not directly comparable with 1.0-1.2. 1.4 = every task carries a grading_cost receipt and the run points at the ledger those receipts came from; scores are unchanged from 1.3 and stay comparable with it."},
    "run_status": {"enum": ["partial", "final", "diagnostic"]},
    "expected_task_count": {"type": "integer", "minimum": 1},
    "expected_ordered_task_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "experiment_id": {"type": "string"},
    "experiment_yaml_name": {"type": "string"},
    "source_inference_experiment_id": {"type": ["string", "null"]},
    "source_inference_run_dir": {"type": ["string", "null"]},
    "source_inference_repo_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "source_inference_revision": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "anchor_projection": {
      "type": ["object", "null"],
      "required": [
        "method",
        "anchor_config_name",
        "anchor_task_count",
        "anchor_ordered_task_ids_sha256",
        "anchor_source_inference_repo_id",
        "baseline_payload_sha256",
        "baseline_schema_version",
        "baseline_perception_wired",
        "baseline_main_calls",
        "baseline_main_latency_ms",
        "baseline_final_json_parse_failed",
        "baseline_empty_final_text",
        "anchor_visual_criteria",
        "anchor_audio_criteria",
        "full_task_count",
        "full_visual_criteria",
        "full_audio_criteria",
        "chunk_envelope_hours"
      ],
      "properties": {
        "method": {"const": "modality_normalized_v1"},
        "anchor_config_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "anchor_task_count": {"type": "integer", "minimum": 1},
        "anchor_ordered_task_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "anchor_source_inference_repo_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "baseline_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "baseline_schema_version": {"const": "1.0"},
        "baseline_perception_wired": {"const": false},
        "baseline_main_calls": {"type": "integer", "minimum": 1},
        "baseline_main_latency_ms": {"type": "number", "exclusiveMinimum": 0},
        "baseline_final_json_parse_failed": {"type": "integer", "minimum": 1},
        "baseline_empty_final_text": {"type": "integer", "minimum": 1},
        "anchor_visual_criteria": {"type": "integer", "minimum": 1},
        "anchor_audio_criteria": {"type": "integer", "minimum": 1},
        "full_task_count": {"type": "integer", "minimum": 1},
        "full_visual_criteria": {"type": "integer", "minimum": 1},
        "full_audio_criteria": {"type": "integer", "minimum": 1},
        "chunk_envelope_hours": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "source_azure_ai_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["endpoint_kind", "profile", "runtime_fingerprint", "workload"],
        "properties": {
          "endpoint_kind": {"enum": ["direct-v1", "project", "legacy-dated"]},
          "profile": {"enum": ["direct-v1", "project-ci", "legacy-rollback"]},
          "runtime_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "workload": {"enum": ["inference", "code-interpreter", "narrative", "grader"]}
        },
        "additionalProperties": false
      }
    },
    "source_azure_ai_provenance_status": {
      "enum": [
        "runtime-verified",
        "runtime-unverified",
        "verified-sidecar",
        "legacy-missing",
        "local-runtime",
        "gold-corpus"
      ]
    },
    "azure_ai_routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["endpoint_kind", "profile", "runtime_fingerprint", "workload"],
        "properties": {
          "endpoint_kind": {"enum": ["direct-v1", "project", "legacy-dated"]},
          "profile": {"enum": ["direct-v1", "project-ci", "legacy-rollback"]},
          "runtime_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "workload": {"const": "grader"}
        },
        "additionalProperties": false
      }
    },
    "azure_ai_runtime_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "grader_source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "renderer_fingerprint": {
      "type": ["object", "null"],
      "required": ["libreoffice_binary", "libreoffice_version", "pymupdf_version"],
      "properties": {
        "libreoffice_binary": {"type": "string", "minLength": 1},
        "libreoffice_version": {"type": "string", "minLength": 1},
        "pymupdf_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "inference_model": {"type": "string"},
    "inference_completed_at": {"type": ["string", "null"]},
    "judge": {
      "type": "object",
      "required": [
        "provider",
        "api",
        "model",
        "deployment",
        "api_version",
        "reasoning_effort",
        "temperature",
        "seed",
        "config_name",
        "config_hash"
      ],
      "properties": {
        "provider": {"type": "string"},
        "api": {"type": "string"},
        "model": {"type": "string"},
        "deployment": {"type": "string"},
        "api_version": {"type": "string"},
        "reasoning_effort": {"type": "string"},
        "temperature": {"type": "number"},
        "seed": {"type": "integer"},
        "config_name": {"type": "string"},
        "config_hash": {"type": "string"},
        "visual_file_cap": {
          "type": "integer",
          "minimum": 1,
          "description": "Resolved per-item visual file cap in force for this run. Not required: grades written before the cap became configurable do not carry it, and for those the cap was 3."
        }
      },
      "additionalProperties": true
    },
    "rubric": {
      "type": "object",
      "required": ["source", "repo_id", "revision", "commit_sha", "short_sha"],
      "properties": {
        "source": {"type": "string"},
        "repo_id": {"type": "string"},
        "revision": {"type": "string"},
        "commit_sha": {"type": "string"},
        "short_sha": {"type": "string"}
      },
      "additionalProperties": true
    },
    "prompt": {
      "type": "object",
      "required": ["template", "version"],
      "properties": {
        "template": {"type": "string"},
        "version": {"type": "string"}
      },
      "additionalProperties": true
    },
    "graded_at": {"type": "string"},
    "graded_by": {"type": "string"},
    "graded_by_version": {"type": "string"},
    "cost_ledger": {"$ref": "#/$defs/costLedgerReference"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "sector",
          "occupation",
          "items",
          "total_awarded",
          "total_max",
          "pct",
          "critical_fail",
          "gold_referenced",
          "judge_call_count",
          "precheck_count",
          "judge_total_latency_ms",
          "judge_input_tokens",
          "judge_output_tokens",
          "graded_at"
        ],
        "properties": {
          "task_id": {"type": "string"},
          "sector": {"type": "string"},
          "occupation": {"type": "string"},
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "rubric_item_id",
                "criterion",
                "max_score",
                "awarded_score",
                "verdict",
                "decided_by",
                "required",
                "evidence",
                "precheck_pattern_id"
              ],
              "properties": {
                "rubric_item_id": {"type": "string"},
                "criterion": {"type": "string"},
                "max_score": {"type": "number"},
                "awarded_score": {"type": "number"},
                "verdict": {"enum": ["pass", "partial", "fail", "judge_error"]},
                "decided_by": {"enum": ["precheck", "judge"]},
                "required": {"type": ["boolean", "null"]},
                "evidence": {"type": "string", "maxLength": 200},
                "judge_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
                "judge_latency_ms": {"type": ["number", "null"], "minimum": 0},
                "precheck_pattern_id": {"type": ["string", "null"]},
                "judge_raw_response": {"type": ["string", "null"]},
                "model_did_right": {"type": "boolean", "description": "Sign-aware right-outcome flag (PR1 task 100). For positive max_score items, true iff verdict='pass'. For negative max_score (penalty) items, true iff verdict!='pass' (i.e. violation did NOT occur). judge_error is conservatively false."},
                "routing_modality": {"type": ["string", "null"], "enum": ["visual", "audio", "formatting", "text", "mixed", null]},
                "perception_called": {"type": "boolean"},
                "tools_used": {"type": ["array", "null"], "items": {"type": "string"}},
                "visual_provenance": {
                  "type": "array",
                  "items": {"$ref": "#/$defs/visualProvenanceEntry"}
                },
                "target_scope": {"type": ["string", "null"], "enum": ["manifest", "file_target", "primary_bundle", "split_children", "selection_error", null]},
                "target_ids": {"type": ["array", "null"], "items": {"type": "string"}},
                "child_grades": {"type": ["array", "null"], "items": {"$ref": "#/$defs/childGrade"}},
                "aggregation_rule": {"type": ["string", "null"], "enum": ["blocking_min_else_mean", null]},
                "selected_paths": {"type": ["array", "null"], "items": {"type": "string"}},
                "support_paths_visible": {"type": ["array", "null"], "items": {"type": "string"}},
                "selection_status": {"type": ["string", "null"]},
                "selection_error": {"type": ["string", "null"]},
                "score_excluded": {"type": "boolean"},
                "judge_call_count": {"type": "integer", "minimum": 0},
                "judge_input_tokens": {"type": "integer", "minimum": 0},
                "judge_output_tokens": {"type": "integer", "minimum": 0},
                "judge_cached_tokens": {"type": "integer", "minimum": 0},
                "perception_call_count": {"type": "integer", "minimum": 0},
                "perception_input_tokens": {"type": "integer", "minimum": 0},
                "perception_output_tokens": {"type": "integer", "minimum": 0},
                "perception_cached_tokens": {"type": "integer", "minimum": 0},
                "perception_total_latency_ms": {"type": "number", "minimum": 0},
                "render_call_count": {"type": "integer", "minimum": 0},
                "render_total_latency_ms": {"type": "number", "minimum": 0},
                "usage_complete": {"type": "boolean"},
                "visual_budget_downgraded": {"type": "boolean", "description": "This item routed to the render path only because one of its selected files carries no text layer, the task could not afford every such render inside `judge.perception.visual.call_cap_per_task`, and it was put back on the text path it would have taken before that escalation existed. The verdict is a real verdict read off a readable file, not an exclusion — but it was read where a picture was preferred. See the task-level `visual_budget_fallback` for the shortfall that triggered it."},
